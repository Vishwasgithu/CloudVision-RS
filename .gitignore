# ==========================================
# CloudVision-RS — Git Ignore
# ==========================================

# ==========================================
# Runtime / Training Outputs
# ==========================================
outputs/
runs/
checkpoints/
logs/
*.log

# Generated predictions / visualizations
predictions/
results/
generated/
*.tmp

# ==========================================
# Datasets
# ==========================================
# Large/raw datasets — do not version control
datasets/
data/raw/

# Generated / processed datasets
data/processed/
data/interim/

# Generated patch directories
**/patches/
**/patches_*/

# ==========================================
# Model Artifacts
# ==========================================
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# ==========================================
# Python
# ==========================================
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# ==========================================
# Environment / Secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Jupyter
# ==========================================
.ipynb_checkpoints/

# ==========================================
# Learning / Practice Notebooks
# ==========================================
notebooks/01_pytorch_fundamentals
notebooks/pytorch_basics.ipynb
notebooks/NumPy_ Arrays.ipynb
notebooks/Tensor_Operations.ipynb
notebooks/New_pytorch.ipynb
notebooks/Computer_v.ipynb
notebooks/Challenges.ipynb
notebooks/Important_points_learnings.ipynb

# ==========================================
# IDE / Editor
# ==========================================
.vscode/
.idea/

# ==========================================
# OS
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Kilo
# ==========================================
.kilo/

# ==========================================
# Frontend / Node
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# ==========================================
# Temporary files
# ==========================================
*.bak
*.swp
*.swo
*~

# ==========================================
# API runtime-generated files
# ==========================================
api/static/results/
api/static/uploads/
api/static/scenes/